# Copy to backend/.env and fill in. Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (Module 1) ---
# Docker database (docker compose maps the container's 5432 to port 5433 on your PC).
# Tables are created by:  alembic upgrade head
DATABASE_URL=postgresql+asyncpg://meetmind:YOUR_PASSWORD@127.0.0.1:5433/meetmind

# --- Auth (Module 2) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_FAILS_PER_MIN=5
LOGIN_IP_MAX_FAILS_PER_MIN=30
# Production (frontend and backend on different domains): COOKIE_SECURE=true, COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Comma-separated frontend URLs
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI (Modules 6-8) --- get a free key at https://console.groq.com
# Providers: groq or openai. LLM_PROVIDER is used by the assistant AND the meeting summaries.
# If you only have an OpenAI key, set BOTH of these to openai.
LLM_PROVIDER=groq
TRANSCRIBE_PROVIDER=groq
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Default assistant model for the live agent; GPT-OSS is the supported replacement for the retired Llama model.
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_LLM_MODEL=openai/gpt-oss-20b
# OpenAI API key and models (used when the corresponding provider is openai)
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-6-luna
OPENAI_TRANSCRIBE_MODEL=whisper-1
LLM_TEMPERATURE=0
# Reasoning effort: low for agent calls, medium for summaries.
REASONING_EFFORT=low
SUMMARY_REASONING_EFFORT=medium
REFRESH_REUSE_GRACE_SECONDS=20

EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# FASTEMBED_CACHE_DIR=.cache/fastembed

# --- Recordings & processing ---
MAX_UPLOAD_MB=25
PROCESSING_DELAY_SECONDS=20

# --- RAG / agent tuning ---
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
RETRIEVAL_TOP_K=6
AGENT_MAX_STEPS=8
AGENT_RATE_LIMIT_PER_MINUTE=10
