# ── Backend connection ─────────────────────────────────────────────
# Your FastAPI server. Signups, logins, meetings and tasks are saved through it into PostgreSQL.
VITE_API_URL=http://localhost:8000
VITE_API_PREFIX=/api/v1
# Socket.IO (defaults to VITE_API_URL)
VITE_SOCKET_URL=
VITE_SOCKET_PATH=/socket.io
# true = in-browser demo backend (NOTHING is saved). Keep false for real use.
VITE_USE_MOCK=false

# ── Optional ──
VITE_PUBLIC_APP_URL=http://localhost:5173
VITE_REPO_URL=
